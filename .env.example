# Banco de dados Neon Postgres (use a URL -pooler em produção/serverless)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# URL pública base do cardápio para gerar os QR Codes das mesas (ex: https://cardapio.arenahomebeach.com.br)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Autenticação do painel /admin
ADMIN_PASSWORD="troque-por-uma-senha-forte"
SESSION_SECRET="troque-por-uma-string-aleatoria-com-pelo-menos-32-caracteres"

# Upload de fotos dos produtos (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Notificações Push Web (VAPID - gere com: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@arenahomebeach.com.br"
