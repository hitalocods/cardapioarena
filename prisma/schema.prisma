generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PedidoStatus {
  RECEBIDO
  PREPARANDO
  PRONTO
  ENTREGUE
  CANCELADO
}

enum ComandaStatus {
  ABERTA
  FECHADA
}

enum ComandaTipo {
  MESA
  BALCAO
}

enum PedidoOrigem {
  CLIENTE
  BALCAO
  GARCOM
}

enum FormaPagamento {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
}

enum PagamentoStatus {
  ATIVO
  ESTORNADO
}

model Produto {
  id              String       @id @default(cuid())
  nome            String
  categoria       String       @default("Geral")
  descricao       String       @default("")
  preco           Int          // Preço em centavos
  foto            String?
  ativo           Boolean      @default(true)
  ordem           Int          @default(0)
  controlaEstoque Boolean      @default(false)
  estoque         Int          @default(0)
  estoqueMinimo   Int          @default(5)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  itens           ItemPedido[]

  @@index([ativo, ordem])
  @@index([ativo, categoria, ordem])
}

model Mesa {
  id        String   @id @default(cuid())
  numero    Int      @unique
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativa, numero])
}

model Comanda {
  id                       String        @id @default(cuid())
  tipo                     ComandaTipo   @default(MESA)
  mesaNumero               Int?
  status                   ComandaStatus @default(ABERTA)
  mesaAberta               Int?          @unique
  abertaEm                 DateTime      @default(now())
  fechadaEm                DateTime?
  pediuConta               Boolean       @default(false)
  pediuContaEm             DateTime?
  pediuContaDetalhes       String?
  motivoFechamentoPendente String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt
  pedidos                  Pedido[]
  pagamentos               Pagamento[]

  @@index([status])
  @@index([tipo, status])
  @@index([mesaNumero, status])
}

model Pedido {
  id                 String       @id @default(cuid())
  numero             Int          @unique @default(autoincrement())
  idempotencyKey     String       @unique
  comandaId          String?
  comanda            Comanda?     @relation(fields: [comandaId], references: [id], onDelete: SetNull)
  origem             PedidoOrigem @default(CLIENTE)
  nomeCliente        String
  telefone           String
  mesaNumero         Int?
  observacao         String?
  lancadoPor         String?
  motivoCancelamento String?
  status             PedidoStatus @default(RECEBIDO)
  total              Int          // Total em centavos
  ip                 String
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  itens              ItemPedido[]

  @@index([comandaId])
  @@index([origem, createdAt])
  @@index([status, createdAt])
  @@index([telefone, status])
  @@index([ip, status])
  @@index([mesaNumero, status])
}

model Pagamento {
  id             String          @id @default(cuid())
  comandaId      String
  comanda        Comanda         @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  valor          Int             // Valor devido em centavos
  forma          FormaPagamento
  pagador        String?
  recebidoPor    String?
  status         PagamentoStatus @default(ATIVO)
  motivoEstorno  String?
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  itens          ItemPedido[]

  @@index([comandaId])
  @@index([status, createdAt])
}

model ItemPedido {
  id            String     @id @default(cuid())
  pedidoId      String
  pedido        Pedido     @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId     String?
  produto       Produto?   @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  pagamentoId   String?
  pagamento     Pagamento? @relation(fields: [pagamentoId], references: [id], onDelete: SetNull)
  nomeSnapshot  String
  precoSnapshot Int        // Preço unitário em centavos no momento do pedido
  quantidade    Int

  @@index([pedidoId])
  @@index([produtoId])
  @@index([pagamentoId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
